    "\n",
    "seed=7\n",
    "n1=5\n",
    "n_bits=3\n",
    "rng = np.random.default_rng(seed)\n",
    "bits1=rng.choice([\"0\", \"1\"], size=(n1, n_bits), p=[0.6, 0.4])\n",
    "print(bits1)\n",
    "b=[\"\".join(row) for row in bits1]\n",
    "print(b)\n",
    "a=np.array(b, dtype=f\"<U{n_bits}\")\n",
    "print(a)"
